# --- Foundry deploy values (copy to .env.local and fill) ---
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
ETH_RPC_URL=http://rpc.ritualfoundation.org
INITIAL_MESSAGE=Hello Ritual
MINT_OWNER=0xYOUR_OWNER_ADDRESS
MINT_FEE_WEI=0

# --- Frontend mint hook values ---
VITE_RITUAL_MINT_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT
VITE_RITUAL_MINT_METHOD_NAME=mintRunCard
VITE_RITUAL_MINT_CHAIN_ID=1979

